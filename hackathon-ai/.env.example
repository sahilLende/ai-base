# Copy to .env and fill in what the organisers give you
PROVIDER=openai          # openai (also any OpenAI-compatible API) | anthropic
API_KEY=your-key-here
BASE_URL=                # only if organisers give a custom endpoint, else empty
MODEL=gpt-4o-mini        # chat model name they provide

# Embeddings (optional). If EMBED_MODEL is empty -> app falls back to TF-IDF keyword search.
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=           # empty = reuse API_KEY
EMBED_BASE_URL=          # empty = reuse BASE_URL
